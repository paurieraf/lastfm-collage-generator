{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🎨 Debug: Mock Album Collage (3x3)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/debug_collage.py",
      "args": ["--mock", "-e", "album", "-c", "3", "-r", "3"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🎨 Debug: Mock Artist Collage (5x5)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/debug_collage.py",
      "args": ["--mock", "-e", "artist", "-c", "5", "-r", "5"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🌐 Debug: Live Album Collage (.env)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/debug_collage.py",
      "args": ["--live", "-e", "album"],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🌐 Debug: Live Artist Collage (.env)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/debug_collage.py",
      "args": ["--live", "-e", "artist"],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🎵 Debug: Live Track Collage (.env)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/debug_collage.py",
      "args": ["--live", "-e", "track"],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🧪 Debug: Current Test File (Pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-sv", "${file}"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    }
  ]
}
